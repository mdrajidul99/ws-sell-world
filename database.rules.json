{
  "rules": {
    "conversations": {
      "$conversationId": {
        "messages": {
          ".read": "auth != null && (auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2' || auth.token.email === 'mrs.engineers.bd26@gmail.com' || data.parent().child('metadata/userId').val() === auth.uid || $conversationId.contains(auth.uid))",
          "$messageId": {
            ".write": "auth != null && (auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2' || auth.token.email === 'mrs.engineers.bd26@gmail.com' || (newData.child('senderUid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 1000))"
          }
        },
        "metadata": {
          ".read": "auth != null && (auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2' || data.child('userId').val() === auth.uid)",
          ".write": "auth != null && (auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2' || (!data.exists() && newData.child('userId').val() === auth.uid))"
        }
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'ZMNTSLxjJWOBEK3DlnqxUXQycAO2')"
      }
    }
  }
}
